# Logic Linker - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# 但不要忽略 frontend/lib/ 目录（包含源代码）
!frontend/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 环境变量
.env
.env.local

# 日志文件
*.log
/tmp/
/logs/

# 操作系统
.DS_Store
Thumbs.db

# 测试和覆盖率
.pytest_cache/
.coverage
htmlcov/

# 临时文件
*.tmp
*.bak
*.cache
*.pid

# Next.js
frontend/.next/
frontend/out/
frontend/node_modules/

# 部署相关
deploy-config.json

